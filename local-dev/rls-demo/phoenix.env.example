# RLS/RBAC demo env for Phoenix <-> Keycloak + Postgres row-level
# isolation. Extends local-dev/keycloak/phoenix.env.example with a
# Postgres database (RLS is a no-op on SQLite -- see
# _set_db_isolation_guards in src/phoenix/server/app.py) and the
# project-grant group-mapping file.
#
# Usage (from repo root):
#   cp local-dev/rls-demo/phoenix.env.example local-dev/rls-demo/phoenix.env
#   set -a && source local-dev/rls-demo/phoenix.env && set +a
#   make dev-backend
#
# Run Phoenix natively on the host (make dev-backend), not in the root
# docker-compose stack -- same reasoning as local-dev/keycloak/README.md:
# both the browser and Phoenix need to hit Keycloak at the same
# http://localhost:8080 address.

# --- Core auth (same as local-dev/keycloak) ---
export PHOENIX_ENABLE_AUTH=true
export PHOENIX_SECRET=local-dev-keycloak-secret-CHANGE-ME-0123456789
export PHOENIX_ROOT_URL=http://localhost:6006
export PHOENIX_ACCESS_TOKEN_EXPIRY_MINUTES=10
export PHOENIX_DISABLE_BASIC_AUTH=false

# --- Keycloak OIDC (same realm/client as local-dev/keycloak) ---
export PHOENIX_OAUTH2_KEYCLOAK_DISPLAY_NAME="Keycloak (local)"
export PHOENIX_OAUTH2_KEYCLOAK_CLIENT_ID=phoenix
export PHOENIX_OAUTH2_KEYCLOAK_CLIENT_SECRET=phoenix-dev-secret
export PHOENIX_OAUTH2_KEYCLOAK_OIDC_CONFIG_URL=http://localhost:8080/realms/phoenix-dev/.well-known/openid-configuration
export PHOENIX_OAUTH2_KEYCLOAK_ALLOW_SIGN_UP=true
export PHOENIX_OAUTH2_KEYCLOAK_AUTO_LOGIN=false
export PHOENIX_OAUTH2_KEYCLOAK_GROUPS_ATTRIBUTE_PATH=groups
export PHOENIX_OAUTH2_KEYCLOAK_ALLOWED_GROUPS=phoenix-admins,phoenix-users
# NOT a plain "groups" path + ROLE_MAPPING dict here, unlike
# local-dev/keycloak's base env -- Keycloak's groups claim comes back
# *alphabetically sorted*, and OAuth2Client.extract_and_map_role's
# _normalize_to_single_string takes only the first array element before
# looking it up in ROLE_MAPPING (src/phoenix/server/oauth2.py). Once a
# user carries a second, unmapped group (demo-project-alpha/-beta, for
# project access -- see group-mapping.yaml) that sorts before
# "phoenix-users", the plain-path form silently resolves everyone to
# VIEWER. This JMESPath conditional checks membership directly instead
# of relying on array order, and resolves straight to a Phoenix role
# name, so ROLE_MAPPING itself is intentionally left unset below (with
# a role value already valid, non-empty ROLE_MAPPING would try to look
# "ADMIN"/"MEMBER" up as a *group name* and fail).
export PHOENIX_OAUTH2_KEYCLOAK_ROLE_ATTRIBUTE_PATH="contains(groups, 'phoenix-admins') && 'ADMIN' || (contains(groups, 'phoenix-users') && 'MEMBER' || 'VIEWER')"
export PHOENIX_OAUTH2_KEYCLOAK_ROLE_ATTRIBUTE_STRICT=false
export PHOENIX_OAUTH2_KEYCLOAK_ROLE_RESYNC=true

# --- Row-level isolation (new for this demo) ---
# Postgres, not SQLite -- RLS policies only apply on the postgresql dialect.
export PHOENIX_SQL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Declarative idp-group -> project-glob -> permission mapping, synced into
# project_grants at login (src/phoenix/server/access/idp_sync.py).
export PHOENIX_ACCESS_CONTROL_GROUP_MAPPING_FILE=local-dev/rls-demo/group-mapping.yaml
