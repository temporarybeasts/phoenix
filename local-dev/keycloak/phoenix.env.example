# Stage 1 local SSO test env for Phoenix <-> Keycloak.
#
# Usage:
#   cp local-dev/keycloak/phoenix.env.example local-dev/keycloak/phoenix.env
#   set -a && source local-dev/keycloak/phoenix.env && set +a
#   make dev-backend
#
# Run Phoenix natively on the host (make dev-backend), not in the root
# docker-compose stack, so both the browser and Phoenix hit Keycloak at the
# same http://localhost:8080 address -- see local-dev/keycloak/README.md.

# --- Core auth ---
export PHOENIX_ENABLE_AUTH=true
export PHOENIX_SECRET=local-dev-keycloak-secret-CHANGE-ME-0123456789
export PHOENIX_ROOT_URL=http://localhost:6006
# Short expiry so the revocation-on-next-login test in the README is
# actually observable without waiting on a long-lived token.
export PHOENIX_ACCESS_TOKEN_EXPIRY_MINUTES=10
# Leave basic auth ON for this stage so there's always an admin@localhost
# fallback login while debugging the Keycloak wiring below.
export PHOENIX_DISABLE_BASIC_AUTH=false

# --- Keycloak OIDC ---
export PHOENIX_OAUTH2_KEYCLOAK_DISPLAY_NAME="Keycloak (local)"
export PHOENIX_OAUTH2_KEYCLOAK_CLIENT_ID=phoenix
export PHOENIX_OAUTH2_KEYCLOAK_CLIENT_SECRET=phoenix-dev-secret
export PHOENIX_OAUTH2_KEYCLOAK_OIDC_CONFIG_URL=http://localhost:8080/realms/phoenix-dev/.well-known/openid-configuration
export PHOENIX_OAUTH2_KEYCLOAK_ALLOW_SIGN_UP=true
# Keep the login page visible (don't auto-redirect) while debugging.
export PHOENIX_OAUTH2_KEYCLOAK_AUTO_LOGIN=false

# Group gating: only members of phoenix-admins or phoenix-users may sign in.
# (carol-outsider in the seeded realm has no groups -- use her to test denial.)
export PHOENIX_OAUTH2_KEYCLOAK_GROUPS_ATTRIBUTE_PATH=groups
export PHOENIX_OAUTH2_KEYCLOAK_ALLOWED_GROUPS=phoenix-admins,phoenix-users

# Role mapping, re-synced on every login.
export PHOENIX_OAUTH2_KEYCLOAK_ROLE_ATTRIBUTE_PATH=groups
export PHOENIX_OAUTH2_KEYCLOAK_ROLE_MAPPING=phoenix-admins:ADMIN,phoenix-users:MEMBER
export PHOENIX_OAUTH2_KEYCLOAK_ROLE_ATTRIBUTE_STRICT=false
export PHOENIX_OAUTH2_KEYCLOAK_ROLE_RESYNC=true
